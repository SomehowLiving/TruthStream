# TruthStream API - Phase 1 & 2
# Copy to .env and fill in values

# API
API_PORT=8000
ENVIRONMENT=development

# 0G Chain (Galileo Testnet) - optional for demo (mock mode if not set)
OG_RPC_URL=https://evmrpc-testnet.0g.ai
CHAIN_ID=16602
CONTRACT_ADDRESS=
OG_PRIVATE_KEY=

# 0G Data Availability
OG_DA_ENDPOINT=https://disperser-galileo.0g.ai

# AI Providers (Phase 2) - at least one required for AI analysis
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Search (Phase 3) - optional, falls back to DuckDuckGo
TAVILY_API_KEY=
